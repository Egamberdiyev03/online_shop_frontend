{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**/*",
          "/**/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "api-auth",
      "urls": [
        "/api/Auth/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 5,
        "maxAge": "0u",
        "timeout": "10s"
      }
    },
    {
      "name": "api-products",
      "urls": [
        "/api/Product/**",
        "/api/Category/**",
        "/api/Company/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 100,
        "maxAge": "1h",
        "timeout": "5s"
      }
    },
    {
      "name": "api-user-data",
      "urls": [
        "/api/Order/**",
        "/api/Payment/**",
        "/api/Curier/**",
        "/api/Notification/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 50,
        "maxAge": "5m",
        "timeout": "10s"
      }
    },
    {
      "name": "api-images",
      "urls": [
        "/uploads/**",
        "/images/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "7d",
        "timeout": "3s"
      }
    },
    {
      "name": "external-maps",
      "urls": [
        "https://*.tile.openstreetmap.org/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 500,
        "maxAge": "7d",
        "timeout": "3s"
      }
    }
  ]
}
